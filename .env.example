# GitLab target
GITLAB_HOST=https://gitlab.com

# Authentication mode: shared-token or oauth
MCP_AUTH_MODE=shared-token

# --- shared-token mode ---
# One GitLab identity is shared by this MCP deployment.
GITLAB_TOKEN=replace-me
# private-token or bearer
GITLAB_TOKEN_TYPE=private-token
# Protect the MCP endpoint when it is reachable outside loopback.
MCP_AUTH_TOKEN=replace-with-a-long-random-secret
MCP_ALLOW_INSECURE_NO_AUTH=false

# --- oauth mode ---
# Set MCP_AUTH_MODE=oauth and create a GitLab OAuth application with callback:
#   ${PUBLIC_BASE_URL}/oauth/gitlab/callback
PUBLIC_BASE_URL=https://gitlab-mcp.example.com
GITLAB_OAUTH_CLIENT_ID=replace-with-gitlab-application-id
GITLAB_OAUTH_CLIENT_SECRET=replace-with-gitlab-application-secret
# Generate with: openssl rand -base64 32
OAUTH_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# OAuth persistence:
# - file: encrypted single-node store; not for multiple replicas sharing one file
# - postgres: recommended for production/multi-replica deployments
OAUTH_STORE_DRIVER=file
OAUTH_STORE_PATH=/data/oauth-store.json
# Required when OAUTH_STORE_DRIVER=postgres.
# With the docker compose postgres profile use host `postgres`, not localhost.
OAUTH_DATABASE_URL=postgresql://postgres:change-me@postgres:5432/codex_glab

# Client registration: CIMD is preferred; DCR remains a compatibility fallback.
OAUTH_CIMD_ENABLED=true
# Optional comma-separated hostname allowlist for CIMD metadata documents. Empty = any public HTTPS host.
OAUTH_CIMD_ALLOWED_HOSTS=
# Keep false for public production deployments to block loopback/private/link-local metadata targets.
OAUTH_CIMD_ALLOW_PRIVATE_NETWORK=false
OAUTH_CIMD_FETCH_TIMEOUT_MS=5000
OAUTH_DCR_ENABLED=true

OAUTH_TRANSACTION_TTL_SECONDS=600
OAUTH_CODE_TTL_SECONDS=300
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Safety defaults used by both auth modes
GITLAB_WRITE_ENABLED=false
GITLAB_MERGE_ENABLED=false
# Optional comma-separated project IDs or namespace/project paths.
# Empty = all projects visible to the authenticated GitLab identity.
GITLAB_ALLOWED_PROJECTS=

# MCP HTTP server
MCP_HOST=0.0.0.0
MCP_PORT=3333
MCP_PATH=/mcp
