# GitLab target
GITLAB_HOST=https://gitlab.com
GITLAB_TOKEN=replace-me
# private-token or bearer
GITLAB_TOKEN_TYPE=private-token

# Safety defaults
GITLAB_WRITE_ENABLED=false
GITLAB_MERGE_ENABLED=false
# Optional comma-separated project IDs or namespace/project paths. Empty = all projects visible to the token.
GITLAB_ALLOWED_PROJECTS=

# MCP HTTP server
MCP_HOST=0.0.0.0
MCP_PORT=3333
MCP_PATH=/mcp
# Required for non-loopback binds unless you explicitly accept an unauthenticated endpoint.
MCP_AUTH_TOKEN=replace-with-a-long-random-secret
MCP_ALLOW_INSECURE_NO_AUTH=false
