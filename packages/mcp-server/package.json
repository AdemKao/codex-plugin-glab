{
  "name": "@codex-plugin-glab/mcp-server",
  "version": "0.5.4",
  "private": true,
  "description": "Production-oriented self-hosted GitLab MCP server with per-user OAuth, CIMD, and multi-replica PostgreSQL sessions.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "pg": "^8.16.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.0",
    "typescript": "7.0.2"
  }
}
